# /etc/codeadapt/firewall.env for deploy/host/firewall.sh. No secrets. chmod 644 is fine.

# app or runner
ROLE=runner

# Runner VM: the App VM's private address (the database) and the App subnet (SSH source).
DB_HOST=10.30.1.4
APP_SUBNET=10.30.1.0/24

# App VM: its own private address (DB_PRIVATE_BIND in app.env) and the runner subnet.
APP_PRIVATE_IP=10.30.1.4
RUNNER_SUBNET=10.30.2.0/24
