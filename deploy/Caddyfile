# CodeAdapt reverse proxy (ADR-042, Milestone 3).
#
# SITE_ADDRESS is the public host name, e.g. codeadapt.example.org: Caddy then obtains and
# renews a TLS certificate automatically and redirects HTTP to HTTPS. TLS is NOT verified
# until this runs on a real host with a real DNS name (docs/deployment/production-runbook.md).
# For a local, plain-HTTP check only: SITE_ADDRESS=:80.
{
	# No admin API on the network.
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# API: same origin, so the SameSite=Strict, Path=/api session cookie works. Caddy sets
	# X-Forwarded-For to the real client and ignores any value the client sent (it trusts
	# no upstream proxies by default). The API adds its own security headers to /api.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	# Static single-page app.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			# 'unsafe-inline' for styles only: the code editor (CodeMirror) injects <style>
			# elements at run time. Scripts are same-origin only.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			-Server
		}
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
	}

	log {
		# Caddy's access log would record client addresses and full URIs; the API keeps
		# its own request log without them (ADR-042).
		output discard
	}
}
