# App VM settings for deploy/compose.app.yaml. Copy to deploy/app.env (git-ignored) and
# replace every placeholder. Generate passwords with: openssl rand -base64 32
# Never commit the filled-in file; keep it readable by root only (chmod 600).

# Public host name (DNS must point at this VM). Becomes the TLS certificate name and
# CODEADAPT_ALLOWED_HOSTS.
SITE_HOST=codeadapt.example.invalid

DB_NAME=codeadapt
# Schema owner: migrations only.
DB_OWNER_USER=codeadapt_owner
DB_OWNER_PASSWORD=CHANGE_ME_owner_password
# Login roles, created and granted by the db-setup service (codeadapt-admin db-setup).
API_DB_USER=codeadapt_api
API_DB_PASSWORD=CHANGE_ME_api_password
# The same worker password goes into the runner VM's runner.env.
WORKER_DB_USER=codeadapt_worker
WORKER_DB_PASSWORD=CHANGE_ME_worker_password

# This VM's PRIVATE address, reachable by the runner VM only. Never a public address.
DB_PRIVATE_BIND=10.30.1.4

# Output of deploy/db-tls/make-db-certs.sh <dir> db.codeadapt.internal (R5): ca.crt,
# server.crt and server.key. Move ca.key off the VM afterwards.
DB_TLS_DIR=/etc/codeadapt/db-tls

# Self-service sign-up (ADR-044). Leave empty to keep it off. `invite-code` shows
# "Create an account" on the login page; students then need a code issued with
#   docker compose ... run --rm admin invite-create --label "CS101 Tue" --max-uses 40 --days 14
# New accounts are students with data class `dev` (no real-student enrolment before Gate C).
SIGNUP_MODE=

# From release-images.env (deploy/pull-images.sh prints it).
IMAGE_TAG=local
