# Runner VM settings for deploy/compose.runner.yaml. Copy to deploy/runner.env
# (git-ignored), replace every placeholder, chmod 600. This is the ONLY secret on the
# runner VM.

# The App VM's PRIVATE address, and the name in its database certificate (R5).
DB_HOST=10.0.0.4
DB_TLS_NAME=db.codeadapt.internal
# ca.crt from deploy/db-tls/make-db-certs.sh, copied to this VM (public, not a secret).
DB_CA_FILE=/etc/codeadapt/db-tls/ca.crt
DB_NAME=codeadapt
WORKER_DB_USER=codeadapt_worker
WORKER_DB_PASSWORD=CHANGE_ME_worker_password

# stat -c %g /var/run/docker.sock
DOCKER_SOCKET_GID=999
# At most the VM's cores.
SANDBOX_MAX_CONCURRENCY=2

IMAGE_TAG=local
