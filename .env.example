# Copy to .env and adjust. Never commit .env. Every CODEADAPT_* variable the code reads is listed here.

# Sandbox toolchain image (build with: docker build -t codeadapt-sandbox:gcc14.2-1 sandbox/)
CODEADAPT_SANDBOX_IMAGE=codeadapt-sandbox:gcc14.2-1
# Container runtime. Empty = daemon default (runc, dev tier only).
# Any deployment reachable by students must use gVisor: CODEADAPT_SANDBOX_RUNTIME=runsc
CODEADAPT_SANDBOX_RUNTIME=
# docker CLI binary name or path
CODEADAPT_DOCKER_BINARY=docker
# Maximum concurrently running sandbox containers per worker process
CODEADAPT_SANDBOX_MAX_CONCURRENCY=4
# Set to 1 to make sandbox tests fail (instead of skip) when Docker is unavailable
CODEADAPT_REQUIRE_SANDBOX=0

# Application (M3)
# dev | test | production. The dev auth stub (X-Dev-Role header) is disabled in production.
CODEADAPT_ENV=dev
# SQLite for local development; PostgreSQL (postgresql+psycopg://...) for deployments.
CODEADAPT_DATABASE_URL=sqlite:///./codeadapt-dev.sqlite3
# Problem catalogue directory. Default: content/demo in this repository (public demo content).
# Real study content lives in a private repository (ADR-009).
CODEADAPT_CONTENT_DIR=
CODEADAPT_WORKER_POLL_SECONDS=1.0
# Login sessions (ADR-029): lifetime in hours.
CODEADAPT_SESSION_HOURS=12
# Per-user submission limit per minute. Empty = default (10 in production, no limit otherwise).
CODEADAPT_SUBMISSIONS_PER_MINUTE=

# Logging: json | text (default json in production, text otherwise); level as in Python logging.
CODEADAPT_LOG_FORMAT=
CODEADAPT_LOG_LEVEL=INFO
