# Copy to .env and adjust. Never commit .env. Variables used so far (M1):

# Sandbox toolchain image (build with: docker build -t codeadapt-sandbox:gcc14.2-1 sandbox/)
CODEADAPT_SANDBOX_IMAGE=codeadapt-sandbox:gcc14.2-1
# Container runtime. Empty = daemon default (runc, dev tier only).
# Any deployment reachable by students must use gVisor: CODEADAPT_SANDBOX_RUNTIME=runsc
CODEADAPT_SANDBOX_RUNTIME=
# docker CLI binary name or path
CODEADAPT_DOCKER_BINARY=docker
# Maximum concurrently running sandbox containers per worker process
CODEADAPT_SANDBOX_MAX_CONCURRENCY=4
# Set to 1 to make sandbox tests fail (instead of skip) when Docker is unavailable
CODEADAPT_REQUIRE_SANDBOX=0
